{
  "expo": {
    "name": "Flex",
    "slug": "flex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sn.flex.app",
      "config": {
        "googleMapsApiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_KEY_IOS"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sn.flex.app",
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_KEY_ANDROID"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone-adaptative.png",
        "backgroundColor": "#0B7A5F"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flex utilise votre position pour proposer votre point de départ aux conducteurs proches."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0E1C2C"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flex accède à vos photos pour envoyer votre pièce d’identité, votre permis, votre carte grise et votre photo de profil.",
          "cameraPermission": "Flex utilise l’appareil photo pour le selfie qui sera comparé à votre pièce d’identité."
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afa3a344-8ed0-47f7-b3a5-65806e9f71a2"
      }
    },
    "icon": "./assets/icone.png"
  }
}
