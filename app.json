{
  "expo": {
    "name": "Flex",
    "slug": "flex",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "flex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sn.flex.app",
      "config": {
        "googleMapsApiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_KEY_IOS"
      }
    },
    "android": {
      "package": "sn.flex.app",
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_KEY_ANDROID"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flex utilise votre position pour proposer votre point de départ aux conducteurs proches."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
