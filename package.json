{
  "name": "flex",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "tokens:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tokens-check.mts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db supabase/tests",
    "db:lint": "supabase db lint --level warning --schema public",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:verif-policies": "node scripts/verif-policies.mjs",
    "garde:compte-dev": "node scripts/garde-compte-dev.mjs",
    "eas-build-pre-install": "node scripts/garde-compte-dev.mjs",
    "db:verif-recommandation": "node scripts/verif-recommandation.mjs",
    "diagnostic": "node scripts/diagnostic.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "^57.0.14",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.14",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
