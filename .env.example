# Supabase — projet Flex
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps — DEUX clés, une par plateforme.
#
# Une clé Google ne porte qu'un seul type de restriction : « application iOS »
# (par bundle) ou « application Android » (par SHA-1). Les deux s'excluent. Une
# clé unique obligerait à la laisser sans restriction — c'est-à-dire à la laisser
# utilisable par n'importe qui.
#
# Affichage seul : activer Maps SDK for iOS / for Android, et RIEN d'autre.
# Ni Places, ni Directions, ni Geocoding — ce sont des appels facturés.
#
# Si la clé de la plateforme courante est absente, l'application retombe sur le
# fournisseur de cartes du système. Elle fonctionne, mais elle n'applique plus les
# jetons de thème à la carte.
EXPO_PUBLIC_GOOGLE_MAPS_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_KEY_ANDROID=

# Conditions d'utilisation et politique de confidentialité.
#
# UNE seule source de vérité : le texte publié, hors de l'application. C'est lui
# qu'Apple lit, lui qu'un juriste corrigera, et il se met à jour sans publier une
# version. Le dépôt `mamedine50/flex-legal` porte les pages, `site/` en est la
# source ici.
#
# Vides, les liens retombent sur les pages INTERNES — une trame marquée
# provisoire. Un lien légal mort ressemble à une application cassée ; une trame
# qui dit ce qu'elle est, non.
#
# Seul `https://` est accepté : une URL légale ne s'ouvre pas en clair.
EXPO_PUBLIC_URL_CONDITIONS=https://mamedine50.github.io/flex-legal/conditions.html
EXPO_PUBLIC_URL_CONFIDENTIALITE=https://mamedine50.github.io/flex-legal/confidentialite.html

# L'INTERRUPTEUR DE ZONE.
#
# `1` : l'application fonctionne PARTOUT. Aucun bandeau « hors couverture »,
# aucun verrou sur le bouton GO, la position réelle de l'appareil est acceptée
# où qu'il soit. C'est ce qui permet de jouer une course entière depuis le
# Canada, entre deux téléphones.
#
# Absent ou autre chose que `1` : mode production, restreint au Sénégal.
#
# Sur EAS, il vit dans les variables d'environnement — `preview` à 1,
# `production` à 0. Le profil de build choisit donc le mode, et un binaire de
# production ne peut pas être basculé depuis l'application.
#
# La zone elle-même — la boîte du Sénégal — est dans src/lib/couverture.ts. Il
# n'y a aucune autre coordonnée d'essai dans le code : c'est ce qui permet de
# revenir au mode Sénégal sans nettoyage.
EXPO_PUBLIC_ZONE_TEST=1
